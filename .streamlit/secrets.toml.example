# BELEX Streamlit Secrets Configuration - EXAMPLE FILE
# Kopiere diese Datei zu 'secrets.toml' und fülle deine echten Werte ein
# WICHTIG: secrets.toml NICHT in Git committen!

[gemini]
# Google Gemini API Key
# Erhältlich unter: https://aistudio.google.com/apikey
api_key = "your-api-key-here"

# Filestore ID für die Gesetzessammlung
# Format: fileSearchStores/<store-name>
filestore_id = "fileSearchStores/your-filestore-name"

# Optionale Konfiguration (aktuell nicht verwendet)
project_id = "YOUR PROJECT NAME"

[github]
# GitHub Personal Access Token für automatisches Prompt-Speichern
# Erstelle einen Token unter: https://github.com/settings/tokens
# Benötigte Scopes: repo (full control of private repositories)
# Siehe GITHUB_TOKEN_SETUP.md für detaillierte Anleitung
token = "ghp_your_token_here"

# Repository im Format: username/repo
repo = "bottych8ck/belexsearch"

# Branch für Prompt-Speicherung
branch = "unibe-version"
